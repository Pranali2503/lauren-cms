{
  "kind": "collectionType",
  "collectionName": "wellness_subtopics",
  "info": {
    "singularName": "wellness-subtopic",
    "pluralName": "wellness-subtopics",
    "displayName": "Wellness Subtopic"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } },
      "required": true
    },
    "slug": { "type": "uid", "required": true },
    "order": {
      "type": "integer",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "summary": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "estimatedReadTimeMinutes": {
      "type": "integer",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroImage": {
      "type": "media",
      "pluginOptions": { "i18n": { "localized": true } },
      "multiple": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "contentSteps": {
      "type": "dynamiczone",
      "pluginOptions": { "i18n": { "localized": true } },
      "components": [
        "content.rich-text-block",
        "content.image-block",
        "content.stat-highlight",
        "content.question-block",
        "content.author-block",
        "content.progress-bar",
        "content.embed-block",
        "content.section-block"
      ]
    },
    "wellness_topic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::wellness-topic.wellness-topic",
      "inversedBy": "wellness_subtopics"
    }
  }
}
